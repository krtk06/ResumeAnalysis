# ── Server ──────────────────────────────────────────────
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# CORS_ORIGIN_REGEX=https://resume-analysis-[a-z0-9-]+\.vercel\.app
TRUST_PROXY_HEADERS=false

# ── Embeddings (production uses fastembed/ONNX) ────────
EMBEDDER_BACKEND=auto
FASTEMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDER_CACHE_DIR=/models/fastembed

# ── Upload limits / rate limits ────────────────────────
MAX_UPLOAD_MB=10
MAX_PAGES=10
MAX_JD_CHARS=10000
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=50

# ── OpenCode Go (keep this key server-side only) ───────
LLM_ENABLED=false
LLM_PROVIDER=opencode_go
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/go/openai/v1
OPENCODE_MODEL=beam-free
OPENCODE_FALLBACK_MODEL=glm-5.3-flash
OPENCODE_USER_AGENT=resume-analysis/2.0
OPENCODE_ALLOW_PAID_FALLBACK=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1
LLM_MAX_REQUESTS_PER_DAY=50
LLM_MONTHLY_ALLOWANCE_USD=50
REQUIRE_CONSENT=true

# ── Calibration (generated by eval/calibrate.py) ───────
# CALIBRATION_PATH=/app/calibration.json
