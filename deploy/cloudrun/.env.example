# Copy this file to deploy/cloudrun/.env (gitignored), edit it, then run:
#   ./deploy/cloudrun/bootstrap.sh
#   ./deploy/cloudrun/deploy.sh
#
# The scripts load this file automatically.

PROJECT_ID=
REGION=us-central1
SERVICE_NAME=resume-analysis-api
REPO_NAME=resume-analysis

# Optional. Defaults to resume-api-runtime@<project>.iam.gserviceaccount.com.
RUNTIME_SERVICE_ACCOUNT=

# GitHub repository and branch allowed to deploy through Workload Identity
# Federation. Change these if you use a fork.
GITHUB_REPO=krtk06/ResumeAnalysis
GITHUB_BRANCH=main

# Optional. Set a billing account ID to create a budget alert during bootstrap.
BILLING_ACCOUNT_ID=
BUDGET_AMOUNT=5USD

# Secret Manager secret that holds OPENCODE_API_KEY.
SECRET_NAME=opencode-api-key

# Optional. Read the OpenCode key from a local file during bootstrap. The file
# is not committed and is never printed.
OPENCODE_API_KEY_FILE=

# CORS allowlist for the Vercel frontend. Quote the regex so bash preserves the
# backslashes.
CORS_ORIGINS=https://resume-analysis-ruddy.vercel.app
CORS_ORIGIN_REGEX="https://resume-analysis-[a-z0-9-]+\.vercel\.app"

# Keep AI review off until the Secret Manager secret has a version and
# LLM_ENABLED is deliberately switched to true.
LLM_ENABLED=false

# Optional rate and budget overrides.
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY=50
LLM_MAX_REQUESTS_PER_DAY=50
LLM_MONTHLY_ALLOWANCE_USD=50

# Optional. The deploy script builds a default from the Cloud Run URL; add a
# custom domain here if you map one.
# TRUSTED_HOSTS=
